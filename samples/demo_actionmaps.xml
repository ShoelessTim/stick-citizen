<?xml version="1.0"?>
<!-- Demo bindings in Star Citizen actionmaps format: two vJoy devices, right stick js1, left stick js2. -->
<ActionMaps>
 <ActionProfiles version="1" optionsVersion="2" rebindVersion="2" profileName="default">
  <options type="keyboard" instance="1" Product="Keyboard  {6F1D2B61-D5A0-11CF-BFC7-444553540000}"/>
  <options type="joystick" instance="1" Product=" vJoy Device  {BEAD1234-0000-0000-0000-504944564944}"/>
  <options type="joystick" instance="2" Product=" vJoy Device  {BEAD1234-0000-0000-0000-504944564944}"/>
  <actionmap name="spaceship_movement">
   <action name="v_pitch"><rebind input="js1_y"/></action>
   <action name="v_yaw"><rebind input="js1_rotz"/></action>
   <action name="v_roll"><rebind input="js1_x"/></action>
   <action name="v_strafe_longitudinal"><rebind input="js2_y"/></action>
   <action name="v_strafe_lateral"><rebind input="js2_x"/></action>
   <action name="v_strafe_vertical"><rebind input="js2_rotz"/></action>
   <action name="v_afterburner"><rebind input="js2_button2"/></action>
   <action name="v_brake"><rebind input="js2_button3"/></action>
   <action name="v_ifcs_toggle_vector_decoupling"><rebind input="js2_button5" activationMode="double_tap"/></action>
  </actionmap>
  <actionmap name="spaceship_weapons">
   <action name="v_attack1_group1"><rebind input="js1_button1"/></action>
   <action name="v_attack1_group2"><rebind input="js1_button2"/></action>
  </actionmap>
  <actionmap name="spaceship_general">
   <action name="v_toggle_landing_system"><rebind input="js2_button6"/></action>
   <action name="v_atc_request"><rebind input="js2_hat1_up"/></action>
   <action name="v_emergency_exit"><rebind input="js2_button7" activationMode="hold"/></action>
   <action name="v_toggle_all_doors"><rebind input="js2_button8"/></action>
   <action name="v_toggle_all_doorlocks"><rebind input="js2_button8"/></action>
   <action name="v_toggle_qdrive_engagement"><rebind input="js2_lalt+button9"/></action>
  </actionmap>
  <actionmap name="spaceship_targeting">
   <action name="v_target_cycle_hostile_fwd"><rebind input="js1_hat1_right"/></action>
   <action name="v_weapon_countermeasure_decoy_launch"><rebind input="js1_button4"/></action>
   <action name="v_weapon_countermeasure_noise_launch"><rebind input="js1_ "/></action>
  </actionmap>
 </ActionProfiles>
</ActionMaps>
